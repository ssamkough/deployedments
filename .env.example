# Copy to .env for local builds. On Netlify, set these under
# Site configuration -> Environment variables (mark them as secrets).

# Netlify personal access token (User settings -> Applications -> Personal access tokens)
NETLIFY_AUTH_TOKEN=

# Vercel access token (Account settings -> Tokens). Scope it to every team you want listed.
VERCEL_TOKEN=

# Optional: raises the GitHub rate limit from 60/hr and lets private repos be inspected for
# integrations (read-only "Contents" + "Metadata" permission is enough).
GITHUB_TOKEN=

# Optional: Microlink API key. The free tier is ~50 screenshots/day; screenshots are cached
# between builds so this mostly matters on the very first build.
MICROLINK_API_KEY=

# Optional: set to "off" to skip screenshots entirely (placeholders are shown instead).
SCREENSHOTS=on
